From 2f7782f5dfcba6d07af23c58af28eee1d732dcb7 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Wed, 26 Aug 2026 20:57:35 +0000
Subject: [PATCH] Let Android retry lower GLES versions instead of losing the
 GPU

Android does not build SwiftShader, so ShouldFallbackToSWIfGLES3NotSupported()
answering yes promises a software renderer that is not there. Its only real
effect is to clear allow_es_version_fallback at the two call sites that read
it, and that switches off the retry already sitting in GLContextEGL. A device
whose driver refuses an ES3 context gets EGL_BAD_MATCH or EGL_BAD_ATTRIBUTE,
no second attempt, and a GPU process with nowhere to go.

Answer no on Android instead, so the existing walk down from 3.1 to 3.0 to 2.0
stays available. The failures along the way were already logged and the
success was not, so log that too: when a report says the browser started, we
want to know which version it settled on.

Devices that are handed ES3 on the first try never reach any of this. The
retry only runs once eglCreateContext has already failed.
---
 ui/gl/gl_context_egl.cc | 2 ++
 ui/gl/gl_features.cc    | 7 +++++++
 2 files changed, 9 insertions(+)

diff --git a/ui/gl/gl_context_egl.cc b/ui/gl/gl_context_egl.cc
index ff6ae82a43..0f08ad5416 100644
--- a/ui/gl/gl_context_egl.cc
+++ b/ui/gl/gl_context_egl.cc
@@ -402,6 +402,8 @@ bool GLContextEGL::InitializeImpl(GLSurface* compatible_surface,
                            context_attributes.data());
       // Stop searching as soon as a context is successfully created.
       if (context_) {
+        LOG(WARNING) << "Fallback eglCreateContext ES " << version.first << "."
+                     << version.second << " succeeded.";
         return true;
       } else {
         LOG(ERROR) << "Fallback eglCreateContext ES " << version.first << "."
diff --git a/ui/gl/gl_features.cc b/ui/gl/gl_features.cc
index 99bfd69948..216397dd37 100644
--- a/ui/gl/gl_features.cc
+++ b/ui/gl/gl_features.cc
@@ -276,6 +276,13 @@ void GetANGLEFeaturesFromCommandLineAndFinch(
 bool ShouldFallbackToSWIfGLES3NotSupported() {
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_CHROMEOS)
   return base::FeatureList::IsEnabled(kFallbackToSWIfGLES3NotSupported);
+#elif BUILDFLAG(IS_ANDROID)
+  // Android does not build SwiftShader, so there is no software renderer to
+  // fall back to. Answering yes here only clears allow_es_version_fallback at
+  // the two call sites, which turns a refused ES3 context into a dead GPU
+  // process with nothing behind it. Let GLContextEGL retry 3.1 -> 3.0 -> 2.0
+  // instead.
+  return false;
 #else   // BUILDFLAG(IS_WIN) || BUILDFLAG(IS_CHROMEOS)
   return true;
 #endif  // BUILDFLAG(IS_WIN) || BUILDFLAG(IS_CHROMEOS)
