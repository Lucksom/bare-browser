+++ b/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/phone/stack/StackLayout.java
@@ -0,0 +1,210 @@
+// Copyright 2015-2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.compositor.layouts.phone.stack;
+
+import android.content.Context;
+import android.graphics.RectF;
+import android.view.MotionEvent;
+import android.view.VelocityTracker;
+
+import org.chromium.chrome.browser.compositor.layouts.Layout;
+import org.chromium.chrome.browser.compositor.layouts.LayoutManagerHost;
+import org.chromium.chrome.browser.compositor.layouts.LayoutRenderHost;
+import org.chromium.chrome.browser.compositor.layouts.components.LayoutTab;
+import org.chromium.chrome.browser.compositor.scene_layer.TabListSceneLayer;
+import org.chromium.chrome.browser.layouts.EventFilter;
+import org.chromium.chrome.browser.layouts.LayoutType;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.tabmodel.TabModelUtils;
+import org.chromium.ui.resources.ResourceManager;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Layout that presents tabs as a 3D vertical stack of overlapping cards
+ * (the classic pre-Chromium 88 mobile tab switcher design).
+ * Completely unwinds and omits Tab Groups; all tabs are treated as single cards.
+ */
+public class StackLayout extends Layout {
+    private static final float STACK_CARD_OVERLAP_FACTOR = 0.22f;
+    private static final float CARD_TILT_DEGREES = 14.0f;
+    private static final float MAX_PERSPECTIVE_SCALE = 0.94f;
+
+    private final List<StackTab> mStackTabs = new ArrayList<>();
+    private final StackAnimation mAnimation;
+    private float mScrollOffset;
+    private float mMaxScrollOffset;
+    private boolean mIsDragging;
+    private float mLastTouchY;
+    private VelocityTracker mVelocityTracker;
+    private boolean mIsIncognito;
+
+    public StackLayout(Context context, LayoutManagerHost host, LayoutRenderHost renderHost) {
+        super(context, host, renderHost);
+        mAnimation = new StackAnimation(this);
+    }
+
+    @Override
+    public @LayoutType int getLayoutType() {
+        return LayoutType.TAB_SWITCHER;
+    }
+
+    @Override
+    public void show(long time, boolean animate) {
+        super.show(time, animate);
+        mIsIncognito = getTabModelSelector().isIncognitoSelected();
+        buildStackFromModel();
+        requestUpdate();
+    }
+
+    /**
+     * Switch between Normal stack and Incognito stack (classic pre-88 toggle).
+     */
+    public void setIncognitoMode(boolean incognito) {
+        if (mIsIncognito != incognito) {
+            mIsIncognito = incognito;
+            getTabModelSelector().selectModel(incognito);
+            mScrollOffset = 0;
+            buildStackFromModel();
+            requestUpdate();
+        }
+    }
+
+    private void buildStackFromModel() {
+        mStackTabs.clear();
+        TabModel model = getTabModelSelector().getModel(mIsIncognito);
+        int count = model.getCount();
+        int selectedIndex = model.index();
+
+        float cardHeight = getHeight() * 0.70f;
+        float cardWidth = getWidth() * 0.92f;
+        float stepY = cardHeight * STACK_CARD_OVERLAP_FACTOR;
+
+        for (int i = 0; i < count; i++) {
+            Tab tab = model.getTabAt(i);
+            StackTab stackTab = new StackTab(tab.getId(), i);
+            float topY = i * stepY - mScrollOffset;
+            
+            // Compute 3D stack perspective depth
+            float progress = Math.max(0.0f, Math.min(1.0f, (float) i / Math.max(1, count - 1)));
+            float scale = 1.0f - (1.0f - MAX_PERSPECTIVE_SCALE) * (1.0f - progress);
+            
+            stackTab.setBounds(
+                    (getWidth() - cardWidth) / 2.0f,
+                    topY,
+                    cardWidth,
+                    cardHeight,
+                    scale,
+                    CARD_TILT_DEGREES
+            );
+            mStackTabs.add(stackTab);
+        }
+        mMaxScrollOffset = Math.max(0, (count - 1) * stepY);
+    }
+
+    @Override
+    protected void updateLayout(long time, long dt) {
+        super.updateLayout(time, dt);
+        mAnimation.update(time, dt);
+    }
+
+    @Override
+    protected EventFilter getEventFilter() {
+        return new EventFilter() {
+            @Override
+            public boolean onInterceptTouchEvent(MotionEvent e, boolean isKeyboardShowing) {
+                return true;
+            }
+
+            @Override
+            public boolean onTouchEvent(MotionEvent e) {
+                return handleTouchEvent(e);
+            }
+        };
+    }
+
+    private boolean handleTouchEvent(MotionEvent e) {
+        int action = e.getActionMasked();
+        float y = e.getY();
+        float x = e.getX();
+
+        switch (action) {
+            case MotionEvent.ACTION_DOWN:
+                mLastTouchY = y;
+                mIsDragging = true;
+                if (mVelocityTracker == null) mVelocityTracker = VelocityTracker.obtain();
+                mVelocityTracker.clear();
+                mVelocityTracker.addMovement(e);
+                return true;
+
+            case MotionEvent.ACTION_MOVE:
+                if (mIsDragging) {
+                    float deltaY = mLastTouchY - y;
+                    mScrollOffset = Math.max(0, Math.min(mMaxScrollOffset, mScrollOffset + deltaY));
+                    mLastTouchY = y;
+                    buildStackFromModel();
+                    requestUpdate();
+                    mVelocityTracker.addMovement(e);
+                }
+                return true;
+
+            case MotionEvent.ACTION_UP:
+                mIsDragging = false;
+                for (int i = mStackTabs.size() - 1; i >= 0; i--) {
+                    StackTab card = mStackTabs.get(i);
+                    if (card.containsPoint(x, y)) {
+                        TabModel model = getTabModelSelector().getModel(mIsIncognito);
+                        TabModelUtils.setIndex(model, card.getIndex(), false);
+                        startHiding(card.getTabId(), true);
+                        break;
+                    }
+                }
+                if (mVelocityTracker != null) {
+                    mVelocityTracker.recycle();
+                    mVelocityTracker = null;
+                }
+                return true;
+        }
+        return false;
+    }
+}

