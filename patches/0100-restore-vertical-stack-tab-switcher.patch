From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BareBrowser <bare@browser.local>
Date: Fri, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH] Restore vertical stack tab switcher layout

---
 chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/LayoutManagerChrome.java | 31 ++++++++++++++++++++++++++-----
 chrome/android/java/src/org/chromium/chrome/browser/tasks/tab_management/TabUiFeatureUtilities.java | 14 +++++++++++---
 2 files changed, 37 insertions(+), 8 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/LayoutManagerChrome.java b/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/LayoutManagerChrome.java
index 1111111..2222222 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/LayoutManagerChrome.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/LayoutManagerChrome.java
@@ -25,6 +25,7 @@ import org.chromium.chrome.browser.compositor.layouts.phone.SimpleAnimationLay
 import org.chromium.chrome.browser.compositor.layouts.phone.stack.StackLayout;
 import org.chromium.chrome.browser.tabmodel.TabModelSelector;
 import org.chromium.chrome.browser.tasks.tab_management.TabUiFeatureUtilities;
+import org.chromium.chrome.browser.flags.ChromeFeatureList;
 import org.chromium.ui.resources.dynamics.DynamicResourceLoader;
 
 /**
@@ -45,15 +46,35 @@ public class LayoutManagerChrome extends LayoutManagerImpl {
     protected void init(Context context) {
         super.init(context);
 
-        boolean isGridEnabled = TabUiFeatureUtilities.isGridTabSwitcherEnabled(context);
-        if (isGridEnabled) {
-            createTabSwitcherLayout(context);
-        } else {
-            createStackLayout(context);
+        // Force vertical stack tab switcher layout
+        createStackLayout(context);
+    }
+
+    private void createStackLayout(Context context) {
+        if (mStackLayout == null) {
+            mStackLayout = new StackLayout(context, this, mRenderHost);
         }
+        addLayout(mStackLayout);
+        setTabSwitcherLayout(mStackLayout);
     }
+
+    private StackLayout mStackLayout;
 }
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/tasks/tab_management/TabUiFeatureUtilities.java b/chrome/android/java/src/org/chromium/chrome/browser/tasks/tab_management/TabUiFeatureUtilities.java
index 3333333..4444444 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/tasks/tab_management/TabUiFeatureUtilities.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tasks/tab_management/TabUiFeatureUtilities.java
@@ -35,11 +35,19 @@ public class TabUiFeatureUtilities {
      * @return Whether the Tab Grid / Group UI is enabled.
      */
     public static boolean isGridTabSwitcherEnabled(Context context) {
-        return ChromeFeatureList.sTabGridLayoutAndroid.isEnabled();
+        // Always disable grid tab switcher so vertical stack layout is selected
+        return false;
     }
 
     /**
      * @return Whether the tab strip / tab switcher should use vertical stack.
      */
     public static boolean isTabGroupsAndroidEnabled(Context context) {
-        return ChromeFeatureList.sTabGroupsAndroid.isEnabled();
+        return false;
+    }
+
+    public static boolean isTabSwitcherOnReturnEnabled() {
+        return false;
     }
 }
-- 
2.39.5
