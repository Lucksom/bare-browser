+package org.chromium.chrome.browser.compositor.layouts.phone.stack;
+
+/**
+ * Physics animation driver for StackLayout card fling, snap, and dismiss transitions.
+ */
+public class StackAnimation {
+    private final StackLayout mLayout;
+    private float mVelocity;
+    private boolean mIsAnimating;
+
+    public StackAnimation(StackLayout layout) {
+        mLayout = layout;
+    }
+
+    public void fling(float initialVelocity) {
+        mVelocity = initialVelocity;
+        mIsAnimating = true;
+    }
+
+    public void update(long time, long dt) {
+        if (!mIsAnimating) return;
+
+        float dtSec = Math.min(dt / 1000.0f, 0.05f);
+        mVelocity *= (float) Math.pow(0.85, dtSec * 60.0f);
+
+        if (Math.abs(mVelocity) < 10.0f) {
+            mVelocity = 0.0f;
+            mIsAnimating = false;
+        }
+    }
+
+    public boolean isAnimating() {
+        return mIsAnimating;
+    }
+}
