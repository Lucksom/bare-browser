+package org.chromium.chrome.browser.compositor.layouts.phone.stack;
+
+import android.graphics.RectF;
+
+/**
+ * Encapsulates position, perspective rotation, scale, and touch bounds
+ * for a single card in the 3D Vertical Stack tab switcher.
+ */
+public class StackTab {
+    private final int mTabId;
+    private final int mIndex;
+    private final RectF mBounds = new RectF();
+    private float mScale = 1.0f;
+    private float mTiltDegrees = 0.0f;
+    private float mAlpha = 1.0f;
+    private float mSwipeDismissOffset = 0.0f;
+
+    public StackTab(int tabId, int index) {
+        mTabId = tabId;
+        mIndex = index;
+    }
+
+    public void setBounds(float x, float y, float width, float height, float scale, float tilt) {
+        mBounds.set(x, y, x + width, y + height);
+        mScale = scale;
+        mTiltDegrees = tilt;
+    }
+
+    public boolean containsPoint(float x, float y) {
+        return mBounds.contains(x, y);
+    }
+
+    public int getTabId() {
+        return mTabId;
+    }
+
+    public int getIndex() {
+        return mIndex;
+    }
+
+    public RectF getBounds() {
+        return mBounds;
+    }
+
+    public float getScale() {
+        return mScale;
+    }
+
+    public float getTiltDegrees() {
+        return mTiltDegrees;
+    }
+
+    public void setSwipeDismissOffset(float offset) {
+        mSwipeDismissOffset = offset;
+    }
+
+    public float getSwipeDismissOffset() {
+        return mSwipeDismissOffset;
+    }
+}

